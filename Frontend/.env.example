# Copy this file to .env and fill in your own values.

# Your API Gateway address (Module 7). Use http://localhost:8888 for local dev,
# or your Render URL (e.g. https://api-gateway-xyz.onrender.com) after Module 10.
VITE_API_BASE_URL=https://api-gateway-nul6.onrender.com

# Your Razorpay TEST key ID from Module 6 (starts with rzp_test_).
# Only the key ID goes in the frontend — never the secret.
VITE_RAZORPAY_KEY_ID=
